# MySQL InnoDB Cluster
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=readinvoice
MYSQL_USER=readinvoice
MYSQL_PASSWORD=change_me_db_password

# Database connection (via MySQL Router)
DB_HOST=mysql-router
DB_PORT=6446
DB_PORT_RO=6447
DB_NAME=readinvoice
DB_USER=readinvoice
DB_PASS=change_me_db_password

# Application
APP_DEBUG=false
JWT_SECRET=change_me_jwt_secret_minimum_32_chars
JWT_EXPIRY=3600
UPLOAD_DIR=/var/www/uploads
TESSERACT_LANG=eng
ALLOWED_ORIGINS=http://localhost:8081

# Service URLs
BACKEND_URL=http://backend:8080
FRONTEND_URL=http://frontend:8081

# Rate Limiting
RATE_LIMIT_DEFAULT=100

# vSphere
VSPHERE_URL=https://vcenter.example.com
VSPHERE_USER=administrator@vsphere.local
VSPHERE_PASS=change_me_vsphere_password
VSPHERE_SSL_VERIFY=true

# Microsoft Graph API (for email worker)
GRAPH_API_URL=https://graph.microsoft.com/v1.0
GRAPH_API_TOKEN=change_me_graph_api_token
EMAIL_POLL_INTERVAL=60
EMAIL_MAILBOX=me

# Logging
LOG_LEVEL=info
