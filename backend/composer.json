{
    "name": "procom/backend",
    "description": "proCom Backend API - Invoice OCR processing microservice",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "php-di/slim-bridge": "^3.4",
        "monolog/monolog": "^3.5",

        "thiagoalessio/tesseract_ocr": "^2.13",
        "smalot/pdfparser": "^2.7",
        "guzzlehttp/guzzle": "^7.8",
        "firebase/php-jwt": "^6.10",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9",
        "respect/validation": "^2.3",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.8",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "audit": {
            "abandoned": "report",
            "block-insecure": false
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage/html --coverage-clover coverage/clover.xml",
        "phpstan": "phpstan analyse src --level=8",
        "cs": "phpcs --standard=PSR12 src/",
        "cs:fix": "phpcbf --standard=PSR12 src/",
        "migrate": "php bin/migrate.php"
    }
}
