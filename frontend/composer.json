{
    "name": "readinvoice/frontend",
    "description": "ReadInvoice Frontend - Datastar PHP Dashboard",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "php-di/slim-bridge": "^3.4",
        "monolog/monolog": "^3.5",
        "guzzlehttp/guzzle": "^7.8",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "ReadInvoice\\Frontend\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ReadInvoice\\Frontend\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src --level=6"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-di/slim-bridge": true
        }
    }
}
